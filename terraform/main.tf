terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }

  # Local state on purpose. See DESIGN_DECISIONS.md — S3/DynamoDB locking buys
  # nothing for a single-operator project and adds two AWS dependencies to the
  # very bootstrap problem Terraform is meant to solve here.
  backend "local" {
    path = "terraform.tfstate"
  }
}

provider "aws" {
  region = var.region

  default_tags {
    tags = {
      Project     = var.project_name
      Environment = var.environment
      ManagedBy   = "terraform"
    }
  }
}