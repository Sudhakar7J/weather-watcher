# Base URL of the Go backend.
#
# Copy this file to `.env.local` and adjust for your environment:
#   cp .env.example .env.local
#
# Vite inlines this at BUILD time, so it is configuration rather than a secret,
# and the value ends up visible in the shipped JavaScript. Never put a
# credential here.
#
# Local development:
VITE_API_BASE_URL=https://3qf5nahks4unjawb4ozxqh53yi0mudie.lambda-url.us-east-1.on.aws

# Production (App Runner endpoint). Set this before `npm run build`.
# VITE_API_BASE_URL=https://your-service-url.on.aws.run.app
