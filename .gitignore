# ---------------------------------------------------------------------------
# Project-private documents (never committed)
# ---------------------------------------------------------------------------
prd.md
update.md

# ---------------------------------------------------------------------------
# Terraform
# NOTE: .terraform.lock.hcl is intentionally COMMITTED. It pins provider
# versions so every `terraform init` resolves identically (Terraform best
# practice). The state files that hold real infrastructure data are NOT.
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
tfplan

# Terragrunt / Atlantis scratch dirs
.terragrunt-cache/
.env.atlantis

# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
# Compiled binaries. These paths are anchored deliberately: a bare "backend"
# entry would match backend/ and exclude the entire source tree.
/backend/bin/
*.exe
*.dll
*.so
*.dylib

# Test binaries and coverage
*.test
*.out
coverage.txt

# Go workspace files (local-only overrides)
go.work
go.work.sum

# ---------------------------------------------------------------------------
# Node / Frontend
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.vite/
.cache/
*.tsbuildinfo

# npm / yarn / pnpm artefacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/

# ---------------------------------------------------------------------------
# Environment / secrets
# NEVER commit real credentials. Only *.example / *.template files are safe.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.pub
service-account*.json
credentials.json
secrets.auto.tfvars
*.auto.tfvars
terraform.tfvars
*.tfvars
!example.tfvars
!*.auto.tfvars.example

# ---------------------------------------------------------------------------
# AWS credentials / CLI cache
# ---------------------------------------------------------------------------
.aws/
aws_credentials
*.credentials

# ---------------------------------------------------------------------------
# Local scratch
# ---------------------------------------------------------------------------
tmp/
temp/
.cache/
*.log
*.err
.devpids
*.pid
screenshots/
*.bak
*.tmp
*.orig
*.swp
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Editors
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.iml
